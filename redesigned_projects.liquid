<div class="col-12 col-md-6 mb-4">
  <div class="custom-card h-100 d-flex flex-column">
    {% if project.img %}
      <div class="mb-3 overflow-hidden rounded">
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "350px"
          alt="project thumbnail"
          class="img-fluid rounded"
        %}
      </div>
    {% endif %}
    <div class="card-body-custom flex-grow-1">
      <h3 class="card-title-custom">
        <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}" style="color: inherit; text-decoration: none;">
          {{ project.title }}
        </a>
      </h3>
      <p class="text-muted small mb-3">{{ project.description }}</p>
    </div>

    <div class="card-footer-custom pt-3 d-flex justify-content-between align-items-center" style="border-top: 1px solid var(--card-border);">
      {% if project.github %}
        <a href="{{ project.github }}" target="_blank" rel="noopener noreferrer" class="custom-pill text-decoration-none">
          <i class="fa-brands fa-github"></i> Repository
        </a>
      {% endif %}
      {% if project.redirect %}
        <a href="{{ project.redirect }}" target="_blank" rel="noopener noreferrer" class="custom-pill text-decoration-none">
          <i class="fa-solid fa-arrow-up-right-from-square"></i> View Project
        </a>
      {% endif %}
    </div>
  </div>
</div>
